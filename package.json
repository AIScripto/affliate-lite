{
  "name": "affiliate-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Unified CPA Affiliate Tracking Platform (Oval Media + Max Wave)",
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "seed": "npm run db:seed --prefix backend",
    "test:backend": "npm test --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "check": "./scripts/verify-code-quality.sh",
    "verify": "./scripts/verify-code-quality.sh"
  },
  "devDependencies": {}
}
