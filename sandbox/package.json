{
  "name": "affiliate-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Test-only fake network and fake publisher that exercise the affiliate tracker end to end. Never deploy to production.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test:all": "tsx src/cli.ts",
    "cleanup": "tsx src/cli.ts --cleanup",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
