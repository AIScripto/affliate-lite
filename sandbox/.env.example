# Port the sandbox listens on
PORT=9999

# Tracker panel address (its nginx forwards /click, /postback and /api to the backend)
TRACKER_URL=http://161.97.110.121:3085

# Public address of THIS sandbox. The tracker sends publisher postbacks here,
# so it must be reachable from the tracker server (a public IP, not localhost).
SANDBOX_PUBLIC_URL=http://161.97.110.121:9999

# Password for the sandbox screen and API (user name can be anything)
SANDBOX_PASSWORD=change-me

# Tracker admin login, used to create and clean up the sandbox test records
TRACKER_ADMIN_EMAIL=
TRACKER_ADMIN_PASSWORD=

# Security token set on the "Sandbox Offer (token)" offer
SANDBOX_OFFER_TOKEN=sbx_secret_token
