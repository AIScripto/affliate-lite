# Entry for Affiliate Tracker in the server's SHARED Caddy (/etc/caddy/Caddyfile, systemd service).
# Caddy gets and renews the Let's Encrypt certificate by itself (ports 80 and 443 must stay open,
# DNS A record affiliate.asesment.com -> 161.97.110.121).
#
# To change it safely (other sites use the same Caddy):
#   cp /etc/caddy/Caddyfile /etc/caddy/Caddyfile.bak.$(date +%F-%H%M)
#   edit only this block
#   caddy validate --config /etc/caddy/Caddyfile   # must say "Valid configuration"
#   systemctl reload caddy                         # reload, never restart: no downtime for other sites
affiliate.asesment.com {
	encode gzip
	reverse_proxy 127.0.0.1:3085
}
