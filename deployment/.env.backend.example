# Backend settings for Affiliate Tracker server. Copy to .env.backend and fill in.
# Server port inside the container (default: 3086)
PORT=3086

# Environment mode
NODE_ENV=production

# PostgreSQL connection string for the remote database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/affiliate_tracker

# JWT Secret for authentication (at least 32 characters)
JWT_SECRET=CHANGE_ME_random_string_of_at_least_32_characters

# Allowed CORS origins (* or specific domain like https://affiliate.example.com)
CORS_ORIGIN=https://affiliate.asesment.com

# Public https address used in links the API gives out (postback URL)
BASE_URL=https://affiliate.asesment.com

# Proxies in front of the backend that may set X-Forwarded-For (nginx in the frontend container = 1)
TRUST_PROXY_HOPS=1
